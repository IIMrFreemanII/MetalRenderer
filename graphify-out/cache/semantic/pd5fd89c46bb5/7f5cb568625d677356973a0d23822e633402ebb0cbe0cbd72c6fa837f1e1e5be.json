{"nodes": [{"id": "claude_skills_performance_references_cpu_swift", "label": "CPU (Swift) practices for MetalRenderer", "file_type": "document", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_performance_references_cpu_swift_frame_loop_outline", "label": "Frame loop outline (Renderer.draw: size, CPU work, plan, stages, encoding, history)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_performance_references_cpu_swift_stage_builder_pattern", "label": "A new pass is a stage builder (takes FramePlan, returns ComputeStage list)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stages read the plan only; state for the next frame is set in finishFrame, because a flag set while stages are being built is read by a later stage of the same frame as if it were last frame's."}, {"id": "claude_skills_performance_references_cpu_swift_never_wait_on_gpu", "label": "Never wait on the GPU (frameSemaphore, three frames in flight)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "frameSemaphore is the only throttle; waitUntilCompleted belongs to setup, acceleration-structure builds, scene swaps and benchmarks."}, {"id": "claude_skills_performance_references_cpu_swift_no_per_frame_allocations", "label": "No allocations per frame (buffers, arrays, strings, closures; setBytes and per-slot uploads)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_performance_references_cpu_swift_hot_loop_practices", "label": "Hot loop practices (final/value types, unsafe buffer pointers, reserveCapacity, SIMD, ARC hoisting)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Algorithmic wins (binned SAH, heaps for edge collapses, precomputed adjacency, spatial hashing) dwarf micro-optimizations; check complexity before tuning constants."}, {"id": "claude_skills_performance_references_cpu_swift_concurrentperform_pattern", "label": "DispatchQueue.concurrentPerform over coarse chunks with disjoint preallocated slots", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each iteration should do at least ~100 microseconds of work and write to its own slot, so no locks or shared appends are needed inside the loop."}, {"id": "claude_skills_performance_references_cpu_swift_background_build_handoff", "label": "Background build handoff pattern (busy, finished, retired after maxFramesInFlight)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heavy per-change CPU work runs on a worker and is installed at a frame boundary; replaced GPU resources are released only after maxFramesInFlight frames because the GPU may still read them. Benchmarks run the job synchronously to stay deterministic."}, {"id": "claude_skills_performance_references_cpu_swift_cpu_gpu_data_layout", "label": "CPU-GPU data layout rules (GPUTypes.swift must match Shaders.metal byte for byte)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SIMD3<Float> is 16 bytes, packed_float3 is 12, Bool sizes differ (use UInt32 flags); shared structs get a stride precondition in validateGPULayouts and a static_assert in MSL."}, {"id": "claude_skills_performance_references_cpu_swift_staging_array_upload", "label": "Big per-frame uploads through a staging array and one copyMemory", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records written one at a time stay in the CPU's caches and the GPU then reads them more slowly: with 16384 moving lights direct writes cost the GPU 0.35 ms a frame."}, {"id": "claude_skills_performance_references_cpu_swift_disk_cache_versioning", "label": "Versioned disk caches in Assets/.metalrenderer-cache", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key the cache by source identity plus a format/algorithm version; bump the version when the builder's output changes or stale caches hide the change and its cost."}, {"id": "claude_skills_performance_references_cpu_swift_cpu_tools", "label": "CPU tools (Debug window orange line, benchmark cpu column, Time Profiler, Allocations)", "file_type": "rationale", "source_file": ".claude/skills/performance/references/cpu-swift.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_performance_references_cpu_swift", "target": "claude_skills_performan