{"nodes": [{"id": "readme_metalgi", "label": "MetalGI Real-Time Ray Tracer", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_custom_ray_tracer", "label": "Custom Two-Level BVH Ray Tracer", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On M1 Max (no RT hardware) it is 19-24% faster per frame than Metal's intersector in the stress test; one loop for both levels almost halved closest-hit cost by avoiding SIMD lanes waiting across levels."}, {"id": "readme_binned_sah_blas", "label": "Binned SAH Bottom-Level BVH (CPU)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gpu_lbvh_rebuild", "label": "Per-Frame GPU LBVH Top-Level Rebuild (Morton, bitonic sort, Karras)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilt from scratch each frame in 0.08-0.12 ms; a CPU SAH tree traces only 4-7% faster."}, {"id": "readme_single_loop_traversal", "label": "Single-Loop Two-Level Traversal", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nesting BLAS loop inside TLAS loop made SIMD lanes wait on each other; merging almost halved closest-hit cost."}, {"id": "readme_metal_acceleration_structures", "label": "Metal Acceleration Structures / Intersector", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as a selectable alternative (METALGI_RT=metal); TLAS rebuilt every 16 frames because refits degraded rays 35% over 256 frames."}, {"id": "readme_virtual_geometry", "label": "Virtual Geometry (Nanite-style LOD)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gallery's 17.9M triangles trace as a 0.4M-triangle cut in 40 MB instead of ~1.5 GB at about the same speed; one SAH tree per model over the cut beat a tree of clusters (2x slower due to overlapping cluster boxes)."}, {"id": "readme_cluster_lod_dag", "label": "Cluster LOD DAG (128-triangle clusters)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_quadric_simplification", "label": "Quadric Simplification with Locked Group Borders", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locking only group borders, seam-aware sliding and relaxed UV-seam passes took the DAG from 883 root groups to one 366-triangle root."}, {"id": "readme_vg_cluster_mode", "label": "GPU-Driven Cluster Variant (METALGI_VG_MODE=clusters)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works but traces 2x slower than full detail: rays visit 8.6 nodes per ray instead of 3.8."}, {"id": "readme_nanite", "label": "Nanite (Unreal Engine)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_texture_streaming", "label": "Sparse Texture Streaming", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gallery's 2.6 GB of 4K textures need 14 MB from overview; mip levels chosen from largest UV stretch with a histogram to avoid slivers requesting 4K mips."}, {"id": "readme_gltf_loading", "label": "glTF 2.0 Loading (metallic-roughness, KHR_lights_punctual)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ggx_specular", "label": "GGX Specular and Reflection Pass (reflectionKernel)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_light_types", "label": "Light Types (sphere, spot, sun, rect, tube)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shared_light_helpers", "label": "Shared Light Helpers (lightUnshadowed, lightShadowTarget, lightSpecular, penumbraWidth, lightMapVisibility)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every kernel goes through these five helpers so many-light picking, reuse, the shadow denoiser and all GI methods work with any mix of light types."}, {"id": "readme_function_constant_specialization", "label": "Pipeline Specialisation per Light-Type Set (Metal function constants)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No cost for unused light types: a sphere-only scene compiles to the old code and runs at the old speed."}, {"id": "readme_emissive_mesh_lights", "label": "Emissive Mesh Lights (meshLightsKernel)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate path because the shadow denoiser needs an exact unshadowed term that a mesh lacks; denoised by its own SVGF signal."}, {"id": "readme_many_lights_sampling", "label": "Many-Lights Sampling by Light Groups (manyLightsKernel)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shadow rays no longer grow with light count; running it in its own kernel avoids traceKernel's register pressure (4x cheaper)."}, {"id": "readme_restir_temporal_reuse", "label": "ReSTIR-style Temporal Light-Pick Reuse (manyLightsReuseKernel)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuts still-frame flicker by a third for ~0.7 ms; visibility reuse was rejected as it darkened penumbrae (-3 dB)."}, {"id": "readme_light_visibility_maps", "label": "Light-Visibility Maps (lightMapKernel)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets surfels and radiance cascades shade secondary hits without shadow rays; total cost capped at about 16 maps."}, {"id": "readme_radiance_cascades", "label": "Radiance Cascades GI", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default in Cornell: no temporal accumulation so barely flickers and follows moving lights; loses 10 dB in stress scene due to screen-grid probe interpolation across many small object edges."}, {"id": "readme_surfel_gi", "label": "Surfel GI", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most accurate on static and contact areas; stress scene default (8 rays, 64k pool) because surfels live on surfaces."}, {"id": "readme_path_traced_gi", "label": "Path-Traced GI with NEE", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large error mostly missing energy beyond 2 bounces (~88% of reference brightness)."}, {"id": "readme_ea_seed_gibs", "label": "EA SEED GIBS", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shadow_denoiser", "label": "Shadow Denoiser (visibility filtering)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only visibility is noisy so only it is filtered; history clamp prevents moving shadows lagging. Beats SVGF on direct light (43.9 vs 30.2 dB moving)."}, {"id": "readme_amd_fidelityfx_shadow_denoiser", "label": "AMD FidelityFX Shadow Denoiser", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_nvidia_sigma", "label": "NVIDIA SIGMA", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_svgf_denoiser", "label": "SVGF Denoiser (temporalKernel + atrousKernel)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SVGF's long history smears moving shadows because motion vectors move surfaces, not shadows."}, {"id": "readme_taau_upscaler", "label": "Custom TAAU Upscaler (taauKernel)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~0.5 ms cheaper than MetalFX and sharper on still images; Lanczos-3 history resampling, depth-edge motion cut and narrow dilation fixed motion. Lacks thin-feature locks so flickers 3x MetalFX in stress scene."}, {"id": "readme_metalfx_upscaler", "label": "MetalFX Temporal / Spatial Upscaler", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fsr2_thin_feature_locks", "label": "FSR 2 Thin-Feature Locks", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_metalfx_denoised_scaler", "label": "MTLFXTemporalDenoisedScaler", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Costs 4.2 ms on M1 Max, more than SVGF plus temporal scaler (~1.5 ms); may be worth it on M3+."}, {"id": "readme_blue_noise_sampling", "label": "Void-and-Cluster Blue-Noise Sampling", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_karis_2013_representative_point", "label": "Representative Point Specular (Karis 2013)", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_frame_pipeline", "label": "Per-Frame GPU Pass Pipeline", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_trace_kernel", "label": "traceKernel (primary rays, G-buffer, direct light)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_composite_kernel", "label": "compositeKernel (unshadowed light x visibility + indirect, ACES)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_concurrent_encoder_overlap", "label": "Concurrent Encoder Overlap of Cascades and Denoiser", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small dispatches on M1 leave the GPU partly idle; overlapping radiance cascades with the denoiser saves ~0.2 ms."}, {"id": "readme_benchmark_mode", "label": "Benchmark Mode (METALGI_BENCH, Benchmark.swift)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_settings_panel", "label": "Render Settings Panel", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shaders_metal_hot_reload", "label": "Shaders.metal Runtime Compile and Hot Reload", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gpu_types_layout", "label": "GPUTypes.swift Shared Struct Layout", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layout must match Shaders.metal."}, {"id": "readme_cornell_scene", "label": "Cornell Room Scene", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stress_scene", "label": "Stress Test Scene (2000 objects, 256 lights)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small spheres use 320 triangles instead of 1280: 5-6% faster, same look; merging static objects into one mesh made rays 25% slower."}, {"id": "readme_gallery_scene", "label": "glTF Gallery Scene", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_light_demo_scenes", "label": "Light Demo Scenes (spots, sun, area, tubes, emissive, mixed)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_m1_no_rt_hardware", "label": "M1/M2 Lack Ray-Tracing Hardware", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ray budget is the main cost and why the custom BVH can beat Metal's software intersector; recompare on M3+."}], "edges": [{"source": "readme_metalgi", "target": "readme_custom_ray_tracer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_metalgi", "target": "readme_virtual_geometry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_metalgi", "target": "readme_texture_streaming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_metalgi", "target": "readme_radiance_cascades"