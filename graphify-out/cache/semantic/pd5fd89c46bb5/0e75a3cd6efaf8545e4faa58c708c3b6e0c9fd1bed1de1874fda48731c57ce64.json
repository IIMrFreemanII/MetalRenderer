{"nodes": [{"id": "claude_skills_performance_skill", "label": "Performance skill (SKILL.md)", "file_type": "document", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_performance_skill_three_rules", "label": "Three rules: measure every change, score quality, never trust a single run", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The renderer is GPU-bound almost everywhere and timings are noisy, so an optimization only counts with a before/after number, a quality score and repeated runs."}, {"id": "claude_skills_performance_skill_optimization_loop", "label": "The optimization loop (baseline, find the bound, change one thing, A/B, check quality, record)", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Report whole-frame ms on the named GPU with the exact env line, and also record what did not help."}, {"id": "claude_skills_performance_skill_find_the_bound", "label": "Find the bound: cheap experiments (halve scale, sweep threadgroups, RT_STATS, compile a feature out)", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bandwidth-bound passes (temporal, a-trous, composite, upscaler) barely react to ALU changes; ALU-bound ones (trace, ReSTIR) barely react to texture format changes, so find which bound applies before reading code."}, {"id": "claude_skills_performance_skill_noise_guidance", "label": "Measurement noise guidance (0.1-0.4 ms, 0.1-0.2 dB, thermal throttling, no debug builds)", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smaller deltas are noise unless they repeat across alternating rounds; long modes heat the GPU so prefer short, narrowed runs; pass timings and RT_STATS slow the frame."}, {"id": "claude_skills_performance_skill_gpu_kernel_checklist", "label": "Checklist: GPU kernels", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bytes first, fuse before adding a pass, keep big kernels lean, branch on uniforms, reduce before atomics, threadgroup tiles, tune dispatch sizes, do expensive signals at lower rates."}, {"id": "claude_skills_performance_skill_per_frame_cpu_checklist", "label": "Checklist: per-frame CPU / encoding", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frame never waits on the GPU, no allocations in draw, one command buffer per frame, tiny completed handlers, heavy CPU work off the frame loop."}, {"id": "claude_skills_performance_skill_offline_builder_checklist", "label": "Checklist: offline builders (BVH, simplifier, clusterizer, VG pages, textures)", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_performance_skill_done_criteria", "label": "Before declaring done (A/B medians, quality scorer, struct layouts, graphify update)", "file_type": "rationale", "source_file": ".claude/skills/performance/SKILL.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"s