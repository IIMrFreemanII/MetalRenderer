diff --git a/Sources/MetalRenderer/EXP.swift b/Sources/MetalRenderer/EXP.swift
new file mode 100644
index 0000000..a9ada32
--- /dev/null
+++ b/Sources/MetalRenderer/EXP.swift
@@ -0,0 +1,7 @@
+import Foundation
+
+/// EXP: the Metal 4 hang's experiment switches (not committed).
+enum EXP {
+    static func on(_ key: String) -> Bool { ProcessInfo.processInfo.environment[key] != nil }
+    static func int(_ key: String, _ fallback: Int) -> Int { ProcessInfo.processInfo.environment[key].flatMap(Int.init) ?? fallback }
+}
